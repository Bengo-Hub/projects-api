# Projects Service environment template
PROJECTS_APP_NAME=projects-service
PROJECTS_APP_ENV=development
PROJECTS_APP_REGION=africa-east-1
PROJECTS_APP_VERSION=0.1.0

PROJECTS_HTTP_HOST=0.0.0.0
PROJECTS_HTTP_PORT=4005
PROJECTS_HTTP_READ_TIMEOUT=20s
PROJECTS_HTTP_WRITE_TIMEOUT=20s
PROJECTS_HTTP_IDLE_TIMEOUT=90s
# TLS configuration for HTTPS (mkcert certificates) - local development only
# Uncomment and set paths to enable HTTPS
# PROJECTS_HTTP_TLS_CERT_FILE=./config/certs/projects.codevertex.local.pem
# PROJECTS_HTTP_TLS_KEY_FILE=./config/certs/projects.codevertex.local-key.pem

PROJECTS_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/projects?sslmode=disable
PROJECTS_POSTGRES_MAX_OPEN_CONNS=30
PROJECTS_POSTGRES_MAX_IDLE_CONNS=15
PROJECTS_POSTGRES_CONN_MAX_LIFETIME=45m

PROJECTS_REDIS_ADDR=localhost:6380
PROJECTS_REDIS_USERNAME=
PROJECTS_REDIS_PASSWORD=
PROJECTS_REDIS_DB=0
PROJECTS_REDIS_TLS_REQUIRED=false
PROJECTS_REDIS_DIAL_TIMEOUT=5s

PROJECTS_EVENT_BUS=nats
PROJECTS_NATS_URL=nats://localhost:4222
PROJECTS_NATS_STREAM=projects
PROJECTS_NATS_DELIVER_GROUP=projects-workers
PROJECTS_NATS_DLQ_STREAM=projects-dlq

PROJECTS_OTLP_ENDPOINT=

# Auth Service SSO (JWT) settings
PROJECTS_AUTH_SERVICE_URL=https://sso.codevertexitsolutions.com
PROJECTS_AUTH_ISSUER=https://sso.codevertexitsolutions.com
PROJECTS_AUTH_AUDIENCE=codevertex
PROJECTS_AUTH_JWKS_URL=https://sso.codevertexitsolutions.com/api/v1/.well-known/jwks.json
PROJECTS_AUTH_JWKS_CACHE_TTL=3600s
PROJECTS_AUTH_JWKS_REFRESH_INTERVAL=300s
PROJECTS_AUTH_ENABLE_API_KEY_AUTH=true
# Shared platform S2S key (code reads the UNPREFIXED var — envconfig namespace is empty)
INTERNAL_SERVICE_KEY=

